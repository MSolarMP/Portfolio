// Portfolio — "Adventurer's Ledger"
// Every piece of public copy and media lives in this database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Status {
  DRAFT
  PUBLISHED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaState {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum QuestKind {
  CLIENT // "Guild contract"
  PERSONAL // "Personal forge"
}

enum Rarity {
  LEGENDARY
  EPIC
  RARE
}

enum BlockType {
  TEXT
  RICHTEXT
}

enum Channel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Auth (Better Auth core tables)
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

/// All page copy, addressed by a dotted key, e.g. "home.hero.tagline".
model ContentBlock {
  key       String    @id
  page      String
  label     String
  type      BlockType @default(TEXT)
  text      String?
  rich      Json? /// Tiptap JSON when type = RICHTEXT
  order     Int       @default(0)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([page])
}

/// Side quests (hobbies) on the About page.
model Interest {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  tagline   String?
  body      Json?
  attribute String? /// "Perception", "Endurance", …
  stats     Json? /// [{ label, value }]
  order     Int      @default(0)
  status    Status   @default(DRAFT)
  featured  Boolean  @default(false)
  coverId   String?
  cover     Media?   @relation("InterestCover", fields: [coverId], references: [id], onDelete: SetNull)
  albums    Album[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([coverId])
  @@index([status, order])
}

model Album {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  region     String? /// coarse only, e.g. "Eastern Cape"
  order      Int       @default(0)
  interestId String?
  interest   Interest? @relation(fields: [interestId], references: [id], onDelete: SetNull)
  media      Media[]
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([interestId])
}

model Media {
  id        String     @id @default(cuid())
  kind      MediaKind
  state     MediaState @default(UPLOADING)
  key       String     @unique /// path of the original in the private Storage bucket
  filename  String
  mimeType  String
  bytes     Int?
  variants  Json? /// { avif: { 640: key, 1280: key, 1920: key }, webp: {…} }
  width     Int?
  height    Int?
  blurData  String? /// tiny base64 placeholder
  alt       String?
  caption   String?
  exif      Json? /// camera, lens, aperture, shutter, iso — never GPS
  region    String?
  error     String?
  order     Int        @default(0)
  albumId   String?
  album     Album?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  coverOf   Interest[] @relation("InterestCover")
  diagramOf Quest[]    @relation("QuestDiagram")

  @@index([albumId])
  @@index([state])
}

/// Case studies (client) and personal projects.
model Quest {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String /// themed title, e.g. "The Great Migration"
  client      String?
  kind        QuestKind @default(CLIENT)
  rarity      Rarity    @default(EPIC)
  role        String?
  summary     String
  briefing    Json?
  problem     Json?
  constraints Json?
  approach    Json?
  bossFight   Json?
  outcome     Json?
  loot        Json?
  stack       String[]
  diagramId   String?
  diagram     Media?    @relation("QuestDiagram", fields: [diagramId], references: [id], onDelete: SetNull)
  repoUrl     String?
  liveUrl     String?
  featured    Boolean   @default(false)
  status      Status    @default(DRAFT)
  order       Int       @default(0)
  chapterId   String?
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([diagramId])
  @@index([chapterId])
  @@index([status, order])
}

/// Experience entries ("The Chronicle").
model Chapter {
  id        String    @id @default(cuid())
  numeral   String /// "I", "II", "III"
  role      String
  company   String
  location  String?
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  summary   String
  bullets   String[]
  stack     String[]
  order     Int       @default(0)
  quests    Quest[]
}

model Education {
  id          String @id @default(cuid())
  title       String
  institution String
  years       String
  kind        String /// "diploma" | "certification"
  order       Int    @default(0)
}

model Skill {
  id       String  @id @default(cuid())
  name     String
  category String /// frontend | backend | data | mobile | cloud | ai
  headline Boolean @default(false)
  order    Int     @default(0)

  @@unique([category, name])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ─────────────────────────────────────────────────────────────
// Inbox & messaging
// ─────────────────────────────────────────────────────────────

/// "Send a Raven" contact messages.
model Message {
  id         String         @id @default(cuid())
  name       String
  email      String
  company    String?
  purpose    String
  body       String
  readAt     DateTime?      @db.Timestamptz(3)
  archivedAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  notices    Notification[]

  @@index([createdAt])
}

model Notification {
  id         String         @id @default(cuid())
  channel    Channel
  template   String
  to         String
  provider   String
  providerId String?
  status     DeliveryStatus @default(QUEUED)
  attempts   Int            @default(0)
  error      String?
  messageId  String?
  message    Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  @@index([providerId])
  @@index([createdAt])
  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────
// Commendations (LinkedIn recommendations, entered via the admin)
// ─────────────────────────────────────────────────────────────

model Commendation {
  id           String    @id @default(cuid())
  quote        String
  name         String
  headline     String? /// recommender's role at the time, e.g. "CTO at FantasyGo"
  relationship String? /// e.g. "Managed Matthew directly"
  givenOn      DateTime? @db.Date
  profileUrl   String? /// recommender's LinkedIn profile
  featured     Boolean   @default(false)
  status       Status    @default(DRAFT)
  order        Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, order])
}
