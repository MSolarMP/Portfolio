# Copy to .env and fill in. Never commit .env.
# Production values live in Vercel → Project → Settings → Environment Variables.

# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Runtime: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations / Prisma CLI: Session pooler (port 5432) or direct connection
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Site ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth (owner-only magic link) ──
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAILS=""                  # comma-separated allow-list of Keeper emails

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="Matthew Pearce <hello@mattcreates.co.za>"

# ── Media (Supabase Storage) ──
# Project URL: Settings → Data API. Secret key: Settings → API Keys → Secret keys (sb_secret_…).
# The secret key bypasses all access rules: server only, never NEXT_PUBLIC_.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET_ORIGINALS="originals"   # private: full-size uploads
SUPABASE_BUCKET_PUBLIC="media"          # public: resized, metadata-stripped copies

# ── Bot protection (Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Rate limiting (Upstash Redis) ──
# console.upstash.com → your database → REST API → .env tab. Use the normal token, not the read-only one.
# Server only, never NEXT_PUBLIC_. Without these, rate limiting is skipped in development.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Later phases add their variables here when they land.
